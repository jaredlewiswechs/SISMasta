# ─── REQUIRED FOR VERCEL DEPLOYMENT ─────────────────────────────────
# Database (use Vercel Postgres, Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/microschoolos?sslmode=require"

# NextAuth (REQUIRED - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-random-secret-here"
# Set to your Vercel domain (Vercel auto-sets this, but set for custom domains)
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── OPTIONAL INTEGRATIONS ─────────────────────────────────────────
# Stripe (for payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (SendGrid or Postmark)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@microschoolos.com"

# File Storage (S3 or compatible)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
